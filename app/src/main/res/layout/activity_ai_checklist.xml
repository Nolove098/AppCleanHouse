<?xml version="1.0" encoding="utf-8"?>
<!-- AI Checklist – Checklist dọn dẹp cá nhân hóa bằng AI -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/slate_50"
    tools:context=".AiChecklistActivity">

    <!-- ===== HEADER ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/white"
        android:elevation="4dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_chevron_left"
            android:background="@drawable/bg_back_button"
            android:scaleType="centerInside"
            android:contentDescription="Back"
            app:tint="@color/slate_700" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Checklist"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/slate_900" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chuẩn bị trước khi cleaner đến"
                android:textSize="12sp"
                android:textColor="@color/slate_500" />
        </LinearLayout>

        <!-- AI badge -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✨ AI"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/indigo_700"
            android:background="@drawable/bg_circle_indigo"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp" />
    </LinearLayout>

    <!-- ===== BOOKING INFO CARD ===== -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvChecklistService"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏠 Dịch vụ: Deep Clean"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/slate_900" />

            <TextView
                android:id="@+id/tvChecklistDateTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 Mon, Jan 15 – 09:00 AM"
                android:textSize="13sp"
                android:textColor="@color/slate_600"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvChecklistAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 123 Main St"
                android:textSize="13sp"
                android:textColor="@color/slate_600"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ===== LOADING STATE ===== -->
    <LinearLayout
        android:id="@+id/loadingContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/blue_600" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✨ AI đang tạo checklist cho bạn..."
            android:textSize="14sp"
            android:textColor="@color/slate_600"
            android:layout_marginTop="12dp" />
    </LinearLayout>

    <!-- ===== ERROR STATE ===== -->
    <LinearLayout
        android:id="@+id/errorContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="❌ Có lỗi xảy ra"
            android:textSize="14sp"
            android:textColor="@color/slate_600"
            android:gravity="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thử lại"
            android:textAllCaps="false"
            app:backgroundTint="@color/blue_600"
            app:cornerRadius="12dp"
            android:layout_marginTop="12dp" />
    </LinearLayout>

    <!-- ===== CHECKLIST ITEMS ===== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/checklistScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/checklistContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp" />
    </androidx.core.widget.NestedScrollView>

    <!-- ===== PROGRESS BAR (completed/total) ===== -->
    <LinearLayout
        android:id="@+id/progressSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/white"
        android:elevation="8dp"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvProgress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0/0 hoàn thành"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/slate_700" />

            <TextView
                android:id="@+id/tvProgressPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/blue_600" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/blue_600"
            android:progressBackgroundTint="@color/slate_200" />

        <!-- Back to Home button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackToHome"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Quay về trang chủ"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:backgroundTint="@color/slate_900"
            app:cornerRadius="16dp" />
    </LinearLayout>

</LinearLayout>
